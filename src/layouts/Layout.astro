---
import "../styles/global.css";
const { title = "Manada · Clínica Veterinaria en Esplugues", description = "Clínica veterinaria de barrio en Esplugues de Llobregat. Medicina, cirugía y urgencias 24 h para perros, gatos y exóticos. Como en casa, con quirófano. Pide cita." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2c1d14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://charcoles-hub.github.io/demo-veterinaria-manada/img/og.jpg" />
    <meta property="og:url" content="https://charcoles-hub.github.io/demo-veterinaria-manada/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace("//","/")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
